{
  "name": "octopus",
  "version": "0.1.0",
  "private": true,
  "description": "Recoverable Git forge backed by Walrus artifacts and Sui ref manifests.",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm --filter @ducnmm/octopus-shared build && pnpm -r check",
    "dev:docs": "pnpm --filter @octopus/docs dev",
    "dev:server": "pnpm --filter @ducnmm/octopus-shared build && pnpm --filter @octopus/server dev",
    "dev:web": "pnpm --filter @octopus/web dev",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "format": "pnpm -r --if-present format",
    "format:check": "pnpm -r --if-present format:check",
    "octopus": "pnpm --filter @ducnmm/octopus-shared build && pnpm --filter @ducnmm/octopus start",
    "test": "pnpm --filter @ducnmm/octopus-shared build && pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.0.14"
  }
}
