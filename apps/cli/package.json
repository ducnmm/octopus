{
  "name": "@ducnmm/octopus",
  "version": "0.1.0",
  "description": "Command line client for the Octopus recoverable Git forge.",
  "type": "module",
  "main": "./dist/program.js",
  "types": "./dist/program.d.ts",
  "exports": {
    ".": {
      "types": "./dist/program.d.ts",
      "import": "./dist/program.js"
    }
  },
  "bin": {
    "octopus": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run --dir src --passWithNoTests"
  },
  "dependencies": {
    "@mysten/sui": "^2.12.0",
    "@ducnmm/octopus-shared": "workspace:*",
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
