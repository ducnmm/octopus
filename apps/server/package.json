{
  "name": "@octopus/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "OCTOPUS_DATA_DIR=${OCTOPUS_DATA_DIR:-../../data} tsx watch src/index.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@ducnmm/octopus-shared": "workspace:*",
    "@mysten/enoki": "^1.0.8",
    "@mysten/seal": "^1.1.1",
    "@mysten/sui": "^2.12.0",
    "@mysten/walrus": "^1.1.1",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
